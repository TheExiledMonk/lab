  "equations": [
    {"id":"H-001","latex":"W(C)=\\Phi(I_1(C),I_2(C),I_3(C)),\\ C\\in\\mathcal D_C\\subset\\operatorname{Sym}^+(3)","role":"complete local isotropic stored-energy family","depends_on":["DEFORMATION-001","H-002"]},
    {"id":"H-002","latex":"I_1=\\operatorname{tr}C,\\ I_2=\\tfrac12[(\\operatorname{tr}C)^2-\\operatorname{tr}(C^2)],\\ I_3=\\det C","role":"minimal invariant basis","depends_on":["DEF-I01","DEF-I02","DEF-I03"]},
    {"id":"H-003","latex":"F\\mapsto QF\\Rightarrow C\\mapsto C","role":"objectivity","depends_on":["DEFORMATION-001"]},
    {"id":"H-004","latex":"W(R^\\sharp C R)=W(C)","role":"material isotropy","depends_on":["mission:isotropy"]},
