#version 450
#extension GL_ARB_gpu_shader_fp64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
layout(constant_id=0) const uint WG=256;
layout(local_size_x_id=0) in;
/*
CPU KDE REFERENCE

Input: two float64 coordinate vectors and Scott bandwidth h per dimension.
For each query i, source j=0..N-1 (including j==i):
    diff_u=(u[i]-u[j])/h_u; diff_v=(v[i]-v[j])/h_v
    sum += exp(-0.5*(diff_u*diff_u + diff_v*diff_v))
Kernel: exact frozen diagonal two-dimensional Gaussian formula.
Bandwidth: observable_lab001._gaussian_kde_bandwidth (Scott's rule).
Normalization: 2*pi*h_u*h_v*N.
This shader changes execution only.
*/
layout(set=0,binding=0,std430) readonly buffer U { double u[]; };
layout(set=0,binding=1,std430) readonly buffer V { double v[]; };
layout(set=0,binding=2,std430) writeonly buffer O { double outv[]; };
layout(set=0,binding=3,std430) readonly buffer C { double cfg[]; };
double exp64(double x){
 if(x < -745.1332191019411)return 0.0;
 int k=int(floor(x/0.693147180559945309417232121458));
 double r=x-double(k)*0.693147180559945309417232121458, t=1.0, s=1.0;
 for(int q=1;q<=18;++q){t*=r/double(q);s+=t;}
 int e=k+1023;if(e<=0){s*=uint64BitsToDouble(uint64_t(1));e+=1074;}
 return s*uint64BitsToDouble(uint64_t(e)<<52);
}
void main(){
 uint i=gl_GlobalInvocationID.x, n=uint(cfg[0]); if(i>=n)return;
 double s=0.0, hu=cfg[1], hv=cfg[2];
 for(uint tile=0;tile<n;tile+=256u){
  uint end=min(tile+256u,n);
  for(uint j=tile;j<end;++j){double du=(u[i]-u[j])/hu,dv=(v[i]-v[j])/hv;s+=exp64(-0.5*(du*du+dv*dv));}
 }
 outv[i]=s/(6.283185307179586476925286766559*hu*hv*double(n));
}
