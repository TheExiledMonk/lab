# Photon trajectory CSVs are excluded from version control because
# they exceed GitHub's recommended 50 MB per-file size:
#   * high_accuracy trajectories: ~400 MB each
#   * minimum_production trajectories: ~80 MB each
# They can be regenerated from the parent labs (see
# weak_lensing_science001.py and the README).
runs/**/high_accuracy/trajectories/photon_trajectories_*.csv
runs/**/minimum_production/trajectories/photon_trajectories_*.csv

# Downloaded observation inputs can exceed GitHub's 100 MB object limit.
# Labs fetch these FITS files on demand; keep them out of repository history.
runs/**/downloads/**/*.fits

# Raw benchmark observations are external, reproducible inputs and are too
# large for ordinary Git/GitHub storage.
PBUF_raw_benchmark/

# Generated correspondence expansion exceeds GitHub's 100 MB object limit.
runs/wl_arrival_instrument_interaction_contract001/forward_correspondence_manifest.json

# Plots are kept under version control (they are part of the audit trail).
